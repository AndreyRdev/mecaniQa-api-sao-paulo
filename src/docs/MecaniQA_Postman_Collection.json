          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code é 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Preço de venda atualizado com sucesso', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.precoVenda).to.eql(199.90);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "US04 - Excluir Peça (DELETE)",
          "request": {
            "method": "DELETE",
