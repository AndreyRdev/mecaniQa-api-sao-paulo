  "item": [
    {
      "name": "1. Gestão de Peças",
      "item": [
        {
          "name": "US01 - Cadastrar Peça (POST)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"codigoBarras\": \"7891234567890\",\n  \"fornecedorMarca\": \"Bosch\",\n  \"quantidadeEstoque\": 15,\n  \"precoCusto\": 120.5,\n  \"precoVenda\": 189.9,\n  \"tamanho\": \"M\",\n  \"cor\": \"Preto\",\n  \"categoria\": \"MOTOR\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/pecas",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "pecas"
              ]
            },
            "description": "US01: Cadastra uma nova Peça. Salva automaticamente o ID gerado na variável 'peca_id'."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code é 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "var jsonData = pm.response.json();",
                  "if (jsonData && jsonData.id) {",
                  "    pm.collectionVariables.set('peca_id', jsonData.id);",
                  "    pm.test('ID da peça foi gerado', function() {",
                  "        pm.expect(jsonData.id).to.be.a('string');",
                  "    });",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "US02 - Listar TODAS as Peças (GET)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/pecas",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "pecas"
              ]
