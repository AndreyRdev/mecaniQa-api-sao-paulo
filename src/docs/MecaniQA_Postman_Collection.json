                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "pecas",
                "{{peca_id}}"
              ]
            },
            "description": "US02: Busca uma peça específica utilizando o ID salvo na variável de coleção 'peca_id'."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code é 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
