            },
            "description": "Valida que buscar a peça recém deletada retorna status HTTP 404 Not Found."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code é 404 Not Found após exclusão', function () {",
                  "    pm.response.to.have.status(404);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
