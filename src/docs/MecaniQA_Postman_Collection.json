    "name": "MecâniQA API - Collection de Testes (US01 a US08)",
    "description": "Collection oficial de testes REST para a aplicação MecâniQA.\nCobre todas as 8 User Stories solicitadas (US01 a US08) para validação dos endpoints de Peças e Serviços.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
